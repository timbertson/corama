<configuration>
	<appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<pattern>%highlight(%-5level) %cyan(%logger{15}) %yellow(%mdc) %highlight(%msg) %n%ex</pattern>
		</encoder>
	</appender>
	<root level="INFO">
		<appender-ref ref="STDOUT" />
	</root>

	<!-- Rama logs a line per Clojure namespace compile; ~200 of them per Block. -->
	<logger name="rpl.rama" level="WARN" />
</configuration>
